++def test_many_rows_on_the_same_millisecond_across_full_pages_are_all_recorded(ledger):
++    """審閱 F1：1001 列同一毫秒，第一頁 1000 列後不能漏掉第 1001 列。"""
++    same_ms = NOW - 5000
