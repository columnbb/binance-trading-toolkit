++def test_interrupted_write_is_recovered_on_rerun_even_on_the_same_millisecond(ledger, monkeypatch):
++    """審閱 F1/F2：寫到一半被中斷，重跑要補回沒寫到的列（含同一毫秒的）。"""
++    t = NOW - 5000
