+    # ------------------------------------------------------------------
+    # 私有端點：收益紀錄（資金費結算在這裡，不在 userTrades）
+    # ------------------------------------------------------------------
+    def income_history(self, *, income_type: str | None = None, symbol: str | None = None,
+                       start_time_ms: int | None = None, end_time_ms: int | None = None,
